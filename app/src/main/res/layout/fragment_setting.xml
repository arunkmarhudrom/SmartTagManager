<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="12dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- HEADER WITH BACK BUTTON + TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvModuleTitleA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Setting"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SETTINGS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_setting"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="6dp"
                    android:text="RSSI Signal Settings"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <!-- Min RSSI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Min RSSI (dBm) weak-signal"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMinDbmValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="-80 dBm"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMinDbm"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:valueFrom="-150"
                    android:valueTo="-20"
                    android:value="-80" />
            </LinearLayout>

            <!-- Max RSSI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Max RSSI (dBm) strong-signal"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMaxDbmValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="-40 dBm"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMaxDbm"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:valueFrom="-150"
                    android:valueTo="-20"
                    android:value="-40" />
            </LinearLayout>

            <!-- Green Threshold -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Green Above (%)"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvGreenThresholdValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="65%"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderGreenThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:valueFrom="1"
                    android:valueTo="100"
                    android:value="65" />
            </LinearLayout>

            <!-- Yellow Threshold -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Yellow Above (%)"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvYellowThresholdValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="40%"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderYellowThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:valueFrom="1"
                    android:valueTo="100"
                    android:value="40" />
            </LinearLayout>

            <!-- Orange Threshold -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Orange Above (%)"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOrangeThresholdValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="20%"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOrangeThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:valueFrom="1"
                    android:valueTo="100"
                    android:value="20" />
            </LinearLayout>

            <!-- SAVE BUTTON -->
            <Button
                android:id="@+id/btnSaveRssiSettings"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_btn_save"
                android:text="Save Settings"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
